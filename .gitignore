# Machine-specific tools, signing keys and device configuration
/.local/
/dist/
/node_modules/
.DS_Store
__pycache__/
*.pyc
.env
.env.*
*.p12
*.pfx
*.pkcs12
*.jks
*.keystore
*.local.json
*.pem
*.key
*.csr
profiles.xml
session.json
certificate-password.txt
/signing.json
/device.json
/certificates/

# Native helper builds can contain local paths and must stay private.
/scripts/native-home/bin/
/scripts/native-home/obj/
*.dll
*.pdb
*.exe

# Proprietary fonts are injected from .local/ at preview/package time.
/app/assets/private-fonts/
/app/.buildResult/
PP*.ttf
PP*.otf
PP*.woff
PP*.woff2
*.wgt

# Personal studies, research and draft writing stay local.
/explorations/
/docs/research/
/docs/articles/

# Oliver's personal Frame art (JFK diner, Mustang, Superbird, Petty #43).
# Prepared locally by scripts/apply-oliver-assets.py from .local/oliver-wallpapers/.
# These files must never be committed: this fork is public, and committing them
# would publish his personal photos. The copy-in script refuses to run if the
# source folder is missing, and `npm run check:public` still passes with them
# installed because git ignores them here.
/app/assets/wallpapers/jfk-diner*.jpg
/app/assets/wallpapers/mustang-villa*.jpg
/app/assets/wallpapers/superbird-desert*.jpg
/app/assets/wallpapers/petty-43*.jpg
/app/assets/materials/jfk-diner-*.jpg
/app/assets/materials/mustang-villa-*.jpg
/app/assets/materials/superbird-desert-*.jpg
/app/assets/materials/petty-43-*.jpg
# Oliver's Device Photos (Apple TV 4K, PS5 Slim, Sky Q box): transparent PNGs
# prepared locally by scripts/apply-oliver-assets.py from .local/oliver-devices/.
# Same rule: local-only, never committed to the public fork.
# Oliver's theme backgrounds (Minimal / Devices / Futuristic / 90s TV):
# 1920x1080 JPEGs made locally by .local/make-backgrounds.py, installed by
# scripts/apply-oliver-assets.py from .local/oliver-backgrounds/.
# Same rule: local-only, never committed to the public fork.
/app/assets/devices/*.png
/app/assets/theme-backgrounds/*.jpg
